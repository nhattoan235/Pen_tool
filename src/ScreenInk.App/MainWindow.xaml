<Window x:Class="ScreenInk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Ink"
        Icon="Assets/screenink.ico"
        Width="520"
        Height="510"
        MinWidth="460"
        MinHeight="470"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Screen Ink" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="14"
                       Text="Công cụ khoanh và vẽ nhanh trực tiếp trên màn hình." />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="20"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="16">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10"
                             Height="10"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="StatusTitle"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Pointer mode" />
                </StackPanel>
                <TextBlock x:Name="StatusDescription"
                           Margin="20,10,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="Nhấn Ctrl+Shift+D hoặc chọn Start drawing trong tray để bắt đầu." />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Padding="20"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Settings" />

                <TextBlock Margin="0,18,0,6"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Toggle drawing shortcut" />
                <ComboBox x:Name="ToggleHotkeyComboBox"
                          Height="34"
                          AutomationProperties.Name="Toggle drawing shortcut"
                          SelectionChanged="OnToggleHotkeySelectionChanged" />
                <TextBlock x:Name="HotkeyFeedbackText"
                           MinHeight="18"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />

                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Margin="0,16,0,0"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="Start Screen Ink with Windows"
                          Checked="OnStartWithWindowsChanged"
                          Unchecked="OnStartWithWindowsChanged"
                          Content="Start Screen Ink with Windows" />
                <TextBlock Margin="22,5,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Text="Off by default. Uses the current Windows user only."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="12"
                   Text="Phase 9 · Beta readiness" />
    </Grid>
</Window>
