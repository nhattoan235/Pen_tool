<Window x:Class="ScreenInk.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="#01000000"
        Cursor="Arrow"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Grid x:Name="InputSurface"
          Background="#01000000"
          MouseEnter="OnMouseEnter"
          MouseLeave="OnMouseLeave"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseLeftButtonUp="OnMouseLeftButtonUp"
          MouseMove="OnMouseMove"
          MouseRightButtonDown="OnMouseRightButtonDown"
          MouseWheel="OnMouseWheel">
        <Canvas x:Name="InkSurface"
                Background="Transparent"
                IsHitTestVisible="False" />
        <Rectangle x:Name="SelectionAdorner"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   IsHitTestVisible="False"
                   Fill="#0C4091FF"
                   Stroke="#E64091FF"
                   StrokeThickness="1.5"
                   StrokeDashArray="4,3"
                   Visibility="Collapsed" />
        <Grid x:Name="CursorPreview"
              Width="5"
              Height="5"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Ellipse x:Name="InkCursorPreview"
                     Fill="#44FF4A52"
                     Stroke="#E6FF4A52"
                     StrokeThickness="1" />
            <Border x:Name="EraserCursorPreview"
                    Background="#CC252932"
                    BorderBrush="#F51A1D24"
                    BorderThickness="2"
                    CornerRadius="2"
                    Visibility="Collapsed">
                <Grid>
                    <Border x:Name="EraserAccentBorder"
                            Margin="2"
                            BorderBrush="#FFFF4A52"
                            BorderThickness="2"
                            CornerRadius="1" />
                    <TextBlock x:Name="EraserCursorGlyph"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontFamily="Segoe UI Symbol"
                               FontSize="12"
                               FontWeight="Bold"
                               Text="+" />
                </Grid>
            </Border>
            <TextBlock x:Name="LassoCursorPreview"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#F04091FF"
                       FontFamily="Segoe UI Symbol"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Text="◌"
                       Visibility="Collapsed" />
        </Grid>
        <Border x:Name="ToolFeedback"
                Padding="8,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#E61A1D24"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                CornerRadius="7"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="ToolFeedbackText"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
