<Application x:Class="ScreenInk.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111318" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1D24" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7AFBE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5A5F" />
    </Application.Resources>
</Application>
