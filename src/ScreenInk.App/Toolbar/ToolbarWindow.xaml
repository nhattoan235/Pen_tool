<Window x:Class="ScreenInk.App.Toolbar.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="224"
        Height="48"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8ECF2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#34FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="ExpandedSurface"
                Padding="4"
                Background="#F21A1D24"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="Transparent"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="OnDragGripMouseLeftButtonDown"
                        ToolTip="Kéo toolbar">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="3" Height="3" Margin="0,1" Fill="#657080" />
                        <Ellipse Width="3" Height="3" Margin="0,1" Fill="#657080" />
                        <Ellipse Width="3" Height="3" Margin="0,1" Fill="#657080" />
                    </StackPanel>
                </Border>

                <Button x:Name="PointerButton"
                        Grid.Column="1"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnPointerClick"
                        ToolTip="Pointer · thoát vẽ">
                    <Viewbox Stretch="Uniform">
                        <Path Width="20"
                              Height="20"
                              Data="M3,2 L16,13 L10.5,13.5 L13.5,19 L10.5,20 L7.5,14.5 L3,18 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Viewbox>
                </Button>

                <Button x:Name="PenButton"
                        Grid.Column="2"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnPenClick"
                        ToolTip="Pen · bắt đầu vẽ">
                    <Grid Width="22" Height="20">
                        <TextBlock x:Name="ToolGlyph"
                                   Margin="-2,0,5,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="✎" />
                        <Path Margin="0,0,0,2"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Data="M0,0 L3,3 L6,0"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                </Button>

                <Button x:Name="ColorButton"
                        Grid.Column="3"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnColorClick"
                        ToolTip="Đổi màu nhanh · phím 1–5 khi đang vẽ">
                    <Ellipse x:Name="ColorSwatch"
                             Width="16"
                             Height="16"
                             Fill="#FF4A52"
                             Stroke="#66FFFFFF"
                             StrokeThickness="1" />
                </Button>

                <Button x:Name="UndoButton"
                        Grid.Column="4"
                        Width="28"
                        Padding="5"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnUndoClick"
                        ToolTip="Hoàn tác · Ctrl+Z">
                    <Viewbox Stretch="Uniform">
                        <Path Width="20"
                              Height="20"
                              Data="M8,4 L3,9 L8,14 M4,9 H12 C16,9 18,11 18,15"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Button>

                <Button x:Name="RedoButton"
                        Grid.Column="5"
                        Width="28"
                        Padding="5"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnRedoClick"
                        ToolTip="Làm lại · Ctrl+Y">
                    <Viewbox Stretch="Uniform">
                        <Path Width="20"
                              Height="20"
                              Data="M12,4 L17,9 L12,14 M16,9 H8 C4,9 2,11 2,15"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Button>

                <Button x:Name="MoreButton"
                        Grid.Column="6"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnMoreClick"
                        ToolTip="Thêm">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="3" Height="3" Margin="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Ellipse Width="3" Height="3" Margin="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Ellipse Width="3" Height="3" Margin="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Button x:Name="CollapsedButton"
                Width="38"
                Height="38"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F21A1D24"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                Visibility="Collapsed"
                PreviewMouseLeftButtonDown="OnCollapsedMouseLeftButtonDown"
                ToolTip="Click để mở · kéo để di chuyển">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="19">
                        <Grid>
                            <Ellipse Width="14"
                                     Height="14"
                                     Fill="{TemplateBinding Foreground}" />
                            <Ellipse Width="24" Height="24" Stroke="#18FFFFFF" StrokeThickness="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
